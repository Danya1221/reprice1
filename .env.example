# Required. Never commit real credentials.
API_ID=
API_HASH=
SESSION_STRING=
SUPPLIER_BOT=@supplier_bot
TARGET_CHANNEL=@your_channel

# Supplier 1: bot navigation or a static feed.
SOURCE_MODE=bot
REQUEST_TEXT=/start
BUTTON_PATH=Прайс > Актуальный прайс

# Optional second price feed, read by the same Telegram user account.
SUPPLIER_BOT_2=
SOURCE_MODE_2=feed
REQUEST_TEXT_2=/prices
BUTTON_PATH_2=
# Custom closing notices (literal text; built-in detection remains active).
CLOSED_TEXT_1=
CLOSED_TEXT_2=

POLL_SECONDS=600
AFTER_ACTION_DELAY=1
RESPONSE_TIMEOUT=45
PRICE_SETTLE_SECONDS=3
HISTORY_LIMIT=300
# 0 reads the entire static supplier feed; HISTORY_LIMIT is only the action snapshot.
FEED_HISTORY_LIMIT=0
# Stops incomplete catalog traversal with an error instead of publishing a partial result.
MAX_CATALOG_PAGES=200
SEND_DELAY=1

PRICE_HEADER=📦 АКТУАЛЬНЫЙ ПРАЙС
PRICE_CURRENCY=RUB
MARKUP=0
MARKUP_PERCENT=0
SIM_FILTER=all
ALLOW_ACCESSORIES=true

# Comma-separated names or substrings; empty means no restriction.
INCLUDE_BLOCKS=
EXCLUDE_BLOCKS=
INCLUDE_ITEMS=
EXCLUDE_ITEMS=

OFF_HOURS_ENABLED=true
TIMEZONE=Europe/Moscow
OPEN_HOUR=10
CLOSE_HOUR=20

# Optional controller. ADMIN_IDS may contain IDs from a different Telegram account.
# BOT_TOKEN must belong to the bot you open in private chat; use /id to see your user ID.
# A group/channel ID cannot be used as ADMIN_IDS.
BOT_TOKEN=
ADMIN_IDS=
# Saves login, selection, order and published message IDs across redeploys.
DATABASE_URL=

# Mount Railway Volume at /data, then set STATE_FILE=/data/state.json.
# If unset, RAILWAY_VOLUME_MOUNT_PATH is used automatically when present.
# STATE_FILE=/data/state.json

# Temporary browser-based Telegram login:
SETUP_MODE=false
SETUP_KEY=

# Existing Railway names also work; no rename is required:
# CONTROL_BOT_TOKEN -> BOT_TOKEN
# ADMIN_ID -> ADMIN_IDS
# SUPPLIER_QUIET_SECONDS -> PRICE_SETTLE_SECONDS
# WORK_START_HOUR -> OPEN_HOUR
# WORK_END_HOUR -> CLOSE_HOUR
# A nonempty canonical value wins if both names are set.
# SOURCE_MODE_2=feed always disables commands. Use bot for a second supplier bot.
